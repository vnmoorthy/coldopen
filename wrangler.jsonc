{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coldopen",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*", "/agents/*", "/claimed", "/img/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "HQ", "class_name": "HQ" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HQ"] }],
  "kv_namespaces": [{ "binding": "MEDIA", "id": "a59522fd4f5f424bb78980df7be74b44" }],
  "ai": { "binding": "AI" },
  "vars": {
    "PUBLIC_URL": "https://coldopen.vnarasingamoorthy.workers.dev",
    "PAYMENT_LINK": "https://buy.stripe.com/test_cNieV5am70px0O47jK0Ny00",
    "CLAUDE_MODEL": "claude-sonnet-5",
    "HQ_LAT": "37.7786",
    "HQ_LON": "-122.3893"
  }
}
